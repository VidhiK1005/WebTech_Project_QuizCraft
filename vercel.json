{
  "version": 2,
  "buildCommand": "cd client && npm install && npm run build",
  "outputDirectory": "client/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/server/api/index.js"
    }
  ],
  "functions": {
    "server/api/index.js": {
      "runtime": "nodejs22.x",
      "maxDuration": 30,
      "includeFiles": "server/**"
    }
  }
}
